{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/livewire/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/Template_Import_ADAPTIKA.csv",
      "dest": "/Template_Import_ADAPTIKA.csv"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
